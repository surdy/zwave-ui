# Example environment for deploy/compose/docker-compose.yml.
# Copy this file to .env, adjust values, and do not commit the real .env file.
# The real .env is git-ignored and may contain deployment-specific secrets.

# Host path for your Z-Wave controller.
# For a stable path, prefer a value from: ls -l /dev/serial/by-id/
ZWAVE_DEVICE=/dev/ttyACM0

# Required backend session secret. Replace with a long, random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Time zone used by the zwave-js-ui backend container.
TZ=UTC

# Host port for the split zwave-ui frontend reverse-proxy SPA.
FRONTEND_PORT=8092

# Host port for the stock zwave-js-ui backend UI and Z-Wave JS WebSocket server.
BACKEND_PORT=8091
