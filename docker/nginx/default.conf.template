# nginx reverse-proxy config for the standalone zwave-ui frontend.
#
# Rendered from this template by the stock nginx entrypoint at container start
# (envsubst -> /etc/nginx/conf.d/default.conf). Only the ${BACKEND_URL}
# environment variable is substituted; nginx runtime variables ($host, $uri,
# $http_upgrade, ...) are left intact because they are not environment vars.
#
# The zwave-ui SPA talks to its backend using same-origin RELATIVE paths, so
# this proxy must answer /socket.io, /api, /health and /version on behalf of a
# separate zwave-js-ui backend reachable at ${BACKEND_URL}.

# Map the Upgrade header so websocket (socket.io) connections upgrade, while
# plain HTTP long-polling requests get a normal "close" connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen      8080;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Single-page app: serve the requested file if it exists, otherwise fall
    # back to index.html so client-side routing works on deep links/refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # socket.io realtime channel (websocket + long-polling fallback).
    location /socket.io/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Keep long-lived websockets open.
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # REST API.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health/version probes used by the app and orchestrators.
    location = /health {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }
    location = /version {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
    }
}
